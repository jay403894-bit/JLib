<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================ USING JLIB FROM YOUR OWN PROJECT ============================

  Import this ONE file and your project can #include and link everything in the suite. Nothing to
  install, no include directories to type, no list of .libs to keep in step with the suite.

  In your .vcxproj, next to the other <Import> lines:

      <Import Project="C:\JLib\UseJLib.props" />

  or in Visual Studio: View > Property Manager, right-click your project, "Add Existing Property
  Sheet", pick this file. That is the whole setup.

  Then build JLib itself once (open JLib.slnx, Build) so build\x64\<Config>\ exists, and write:

      #include <TaskScheduler.h>
      #include <Renderer2D.h>
      #include <Physics3D.h>

  =============================================================================================
  WHY A PROPERTY SHEET RATHER THAN ONE MERGED JLib.lib

  A merged library only solves the LINK list. You would still be typing include directories by hand,
  which is the larger half of the setup. It would also have to be regenerated on every build, and
  merging Jolt in makes the artifact enormous for no benefit, since the linker already discards
  objects nobody references. A property sheet solves includes, library paths, the .lib list and the
  configuration mapping together, and it is what an SDK normally ships.

  =============================================================================================
  YOUR CONFIGURATION MUST MATCH A JLIB ONE - AND THE CRT IS THE REAL CONSTRAINT

  JLib builds Debug (/MDd), Development (/MD) and Release (/MD). Your project must use the SAME
  runtime library as the JLib configuration it links, because mixing /MDd and /MD is an ODR
  violation that surfaces as heap corruption or 0xC0000409 rather than a clean error - the same trap
  documented in BUILD.md and JLib.Common.props.

  JLibConfig below maps your configuration name onto a JLib output folder. Names that match one of
  the three just work. Anything else falls back to Release, which is correct for any optimized /MD
  build - but if you invent a debug-flavoured configuration name, set JLibConfig yourself:

      <PropertyGroup><JLibConfig>Debug</JLibConfig></PropertyGroup>

  before importing this file.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Where JLib lives. Derived from this file's own location, so it is correct wherever the tree
         is cloned and no absolute path is baked in. -->
    <JLibRoot Condition="'$(JLibRoot)'==''">$(MSBuildThisFileDirectory)</JLibRoot>
    <!-- JLibDir is JLibRoot WITH A GUARANTEED TRAILING SEPARATOR, and every path below uses it.
         Two reasons it is a separate property rather than a reassignment of JLibRoot:

         1. Paths below are built as $(JLibDir)Scheduler\include with no separator of their own. That
            is correct for the default above ($(MSBuildThisFileDirectory) always ends in a backslash)
            and wrong for any caller that supplies JLibRoot itself - a command line, an environment
            variable or a relative clone all lack one. Unnormalised, every include directory silently
            concatenates into "...\JLibScheduler\include" and you get a wall of missing headers
            pointing nowhere near the cause.

         2. A property set on the MSBuild COMMAND LINE (/p:JLibRoot=...) is GLOBAL and cannot be
            reassigned by a project - the assignment is silently ignored. So normalising JLibRoot
            in place worked for the environment-variable path and did nothing for the CI path, which
            is the worst possible split. Writing to a different property always takes effect. -->
    <JLibDir>$([MSBuild]::EnsureTrailingSlash('$(JLibRoot)'))</JLibDir>

    <!-- Map the consumer's configuration onto a JLib one. Only set if the consumer did not. -->
    <JLibConfig Condition="'$(JLibConfig)'=='' and '$(Configuration)'=='Debug'">Debug</JLibConfig>
    <JLibConfig Condition="'$(JLibConfig)'=='' and '$(Configuration)'=='Development'">Development</JLibConfig>
    <JLibConfig Condition="'$(JLibConfig)'==''">Release</JLibConfig>

    <JLibBinDir>$(JLibDir)build\$(Platform)\$(JLibConfig)\</JLibBinDir>

    <!-- DirectXTex ships as a prebuilt lib in BOTH CRT flavours, and the wrong one is not a soft
         failure: linking the /MD build into a /MDd consumer is an LNK2038 on _ITERATOR_DEBUG_LEVEL
         and RuntimeLibrary. Keyed on the CRT rather than the configuration name, exactly like
         JLibConfig above. Development uses /MD like Release, so it takes the release build. -->
    <JLibDxTexCfg Condition="'$(JLibConfig)'=='Debug'">debug</JLibDxTexCfg>
    <JLibDxTexCfg Condition="'$(JLibDxTexCfg)'==''">release</JLibDxTexCfg>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Same list as JLib.Common.props. Duplicated deliberately: that file is INTERNAL to the
           suite and carries build settings a consumer must not inherit, so the two are kept apart
           even though the include list overlaps. -->
      <AdditionalIncludeDirectories>$(JLibDir)Scheduler\include;$(JLibDir)Renderer\include;$(JLibDir)Time\include;$(JLibDir)Assets\include;$(JLibDir)Geometry\include;$(JLibDir)Scene\include;$(JLibDir)Input\include;$(JLibDir)Sound\include;$(JLibDir)PlatformerPhysics2D\include;$(JLibDir)Physics3D\include;$(JLibDir)ThirdParty;$(JLibDir)ThirdParty\Jolt;$(JLibDir)ThirdParty\DirectX-Headers\include;$(JLibDir)ThirdParty\DirectXTex\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>

    <Link>
      <AdditionalLibraryDirectories>$(JLibBinDir);$(JLibDir)ThirdParty\DirectXTex\lib\$(JLibDxTexCfg);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Every JLib library plus the system libraries they need. The linker discards objects from
           libraries you never reference, so naming all of them costs nothing in your binary - a
           project that only touches the scheduler does not pay for the renderer. -->
      <AdditionalDependencies>Scheduler.lib;Renderer.lib;Time.lib;Scene.lib;Input.lib;Sound.lib;PlatformerPhysics2D.lib;Physics3D.lib;Jolt.lib;DirectXTex.lib;d3d12.lib;dxgi.lib;dxguid.lib;d3dcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- ======================= THE DEVELOPMENT CONFIGURATION, FOR CONSUMERS =======================
       Supplied here so an app only has to DECLARE a Development configuration; it inherits the
       settings rather than reinventing them. That is not convenience, it is safety: these libraries
       are built /MD with assertions live and NDEBUG undefined, and a consumer that declared
       Development itself and reached for /MDd would link them anyway and get an
       _ITERATOR_DEBUG_LEVEL mismatch - heap corruption or 0xC0000409, not a clean error.

       Why the configuration exists at all: full Debug is unusable at content scale. Game01's larger
       levels run at ~2 FPS in Debug while Release holds hundreds. That is not a bug to hunt, it is
       what an unoptimized build plus _ITERATOR_DEBUG_LEVEL=2 costs when per-frame work means
       iterating thousands of tiles and bodies. Development keeps symbols, breakpoints, call stacks
       and asserts; it gives up some locals to inlining. Every engine ships this third configuration.

       NDEBUG is deliberately NOT defined - that is what keeps assertions live, and it is why this
       cannot simply be aliased onto a stock Release. Code that branches on NDEBUG to mean
       "optimized" must also check JLIB_DEVELOPMENT, as the scheduler's ParallelFor threshold does.

       TO USE IT: add a Development configuration to your .vcxproj (ProjectConfiguration entry plus
       a Configuration PropertyGroup) and list it in your solution. The compiler settings arrive
       from here. -->
  <PropertyGroup Condition="'$(Configuration)'=='Development'">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Development'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>JLIB_DEVELOPMENT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Fail with a sentence that says what to do, rather than 40 unresolved externals. -->
  <Target Name="JLibCheckBuilt" BeforeTargets="Link" Condition="!Exists('$(JLibBinDir)Scheduler.lib')">
    <Error Text="JLib has not been built for this configuration. Expected '$(JLibBinDir)Scheduler.lib'. Open $(JLibDir)JLib.slnx and build $(JLibConfig)|$(Platform) first. (Your configuration '$(Configuration)' maps to JLib's '$(JLibConfig)'; override with the JLibConfig property if that is wrong.)" />
  </Target>

</Project>
